import numpy as np

from doc_auth.deepfake.aggregation import aggregate_face_predictions, aggregate_frame_scores
from doc_auth.deepfake.audio_analysis import AudioLipSyncAnalyzer
from doc_auth.deepfake.risk_scoring import DeepfakeRiskScorer
from doc_auth.deepfake.temporal_analysis import TemporalAnalyzer, assign_face_tracks
from scripts.benchmark_deepfake import run_benchmark


def test_aggregation_methods_and_empty() -> None:
    assert aggregate_frame_scores([]) is None
    assert aggregate_frame_scores([0.2, 0.8, 0.4], method="max") == 0.8
    assert aggregate_frame_scores([0.2, 0.8, 0.4], method="min") == 0.2
    assert round(aggregate_frame_scores([0.1, 0.9, 0.7, 0.3], method="top_k", top_k=2) or 0.0, 4) == 0.8

    pred_res = aggregate_face_predictions([{"score": 0.4}, {"score": 0.9}], method="max")
    assert pred_res["status"] == "success"
    assert pred_res["aggregated_score"] == 0.9


def test_risk_scorer_inconclusive_and_suspicious() -> None:
    scorer = DeepfakeRiskScorer(suspicious_threshold=0.5)
    inc = scorer.score({"visual": {"status": "no_face", "score": None}})
    assert inc["status"] == "inconclusive"
    assert inc["is_suspicious"] is None

    sus = scorer.score({
        "visual": {"status": "success", "score": 0.85},
        "temporal": {"status": "success", "temporal_score": 0.6},
        "audio": {"status": "success", "lip_sync_score": 0.5},
    })
    assert sus["status"] == "success"
    assert sus["is_suspicious"] is True


def test_audio_analyzer_missing_file() -> None:
    analyzer = AudioLipSyncAnalyzer()
    res = analyzer.analyze("nonexistent_video_file_check.mp4")
    assert res["status"] == "file_not_found"
    assert res["is_suspicious"] is None


def test_benchmark_smoke() -> None:
    summary = run_benchmark(num_frames=5, width=128, height=128)
    assert summary["frames"] == 5
    assert summary["elapsed_sec"] >= 0.0